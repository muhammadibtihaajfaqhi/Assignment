```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Responsive Layout - Grid & Flexbox</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: white;
    padding: 30px 10px;
}

.container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 35px;
    min-width: 1000px;
}

body {
    overflow-x: auto;
}

.device {
    display: flex;
    flex-direction: column;
}

.mobile-device {
    width: 200px;
    flex-shrink: 0;
}

.tablet-device {
    width: 510px;
    flex-shrink: 0;
}

.desktop-device {
    flex: 1;
    min-width: 400px;
}

h1 {
    text-align: center;
    font-size: 28px;
    margin: 10px 0 14px;
    font-weight: 500;
}

.layout {
    display: grid;
    width: 100%;
}

.layout div {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 23px;
    font-weight: 400;
    min-width: 0;
    min-height: 0;
}

.header {
    background: #101729;
    color: white;
}

.menu {
    background: #f33449;
    color: white;
}

.hero {
    background: #4b88c5;
    color: white;
}

.main {
    background: #24364f;
    color: white;
}

.banner {
    background: #ffd166;
    color: #111;
}

.extra {
    background: #49b99a;
    color: #111;
}

.image {
    background: #bfe4e4;
    color: #111;
}

/* MOBILE LAYOUT */
.mobile {
    grid-template-columns: 1fr;
    grid-template-rows: 58px 58px 144px 144px 109px 107px 108px;
}

.mobile .header  { grid-area: 1 / 1; }
.mobile .menu    { grid-area: 2 / 1; }
.mobile .hero    { grid-area: 3 / 1; }
.mobile .main    { grid-area: 4 / 1; }
.mobile .banner  { grid-area: 5 / 1; }
.mobile .extra   { grid-area: 6 / 1; }
.mobile .image   { grid-area: 7 / 1; }

/* TABLET LAYOUT */
.tablet {
    grid-template-columns: 126px 1fr;
    grid-template-rows: 58px 224px 223px 110px 112px;
}

.tablet .header {
    grid-area: 1 / 1 / 2 / 3;
}

.tablet .hero {
    grid-area: 2 / 1 / 3 / 3;
}

.tablet .menu {
    grid-area: 3 / 1 / 6 / 2;
}

.tablet .main {
    grid-area: 3 / 2 / 4 / 3;
}

.tablet .banner {
    grid-area: 4 / 2 / 5 / 3;
}

.tablet .extra {
    grid-area: 5 / 2 / 6 / 3;
    width: 65%;
}

.tablet .image {
    grid-area: 5 / 2 / 6 / 3;
    width: 35%;
    justify-self: end;
}

/* DESKTOP LAYOUT */
.desktop {
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 58px 335px 110px 112px 112px;
}

.desktop .header {
    grid-area: 1 / 1 / 2 / 2;
}

.desktop .menu {
    grid-area: 1 / 2 / 2 / 4;
}

.desktop .hero {
    grid-area: 2 / 1 / 3 / 4;
}

.desktop .main {
    grid-area: 3 / 1 / 5 / 2;
}

.desktop .image {
    grid-area: 3 / 3 / 4 / 4;
}

.desktop .extra {
    grid-area: 4 / 3 / 5 / 4;
}

.desktop .banner {
    grid-area: 5 / 1 / 6 / 4;
}

/* Hide unused blocks in each layout */
.mobile .image { display: flex; }
.mobile .extra { display: flex; }

.tablet .image,
.tablet .extra {
    display: flex;
}
</style>
</head>

<body>

<div class="container">

    <!-- MOBILE -->
    <section class="device mobile-device">
        <h1>MOBILE</h1>
        <div class="layout mobile">
            <div class="header">HEADER</div>
            <div class="menu">MENU</div>
            <div class="hero">HERO</div>
            <div class="main">MAIN</div>
            <div class="banner">BANNER</div>
            <div class="extra">EXTRA</div>
            <div class="image">IMAGE</div>
        </div>
    </section>

    <!-- TABLET -->
    <section class="device tablet-device">
        <h1>TABLET</h1>
        <div class="layout tablet">
            <div class="header">HEADER</div>
            <div class="menu">MENU</div>
            <div class="hero">HERO</div>
            <div class="main">MAIN</div>
            <div class="banner">BANNER</div>
            <div class="extra">EXTRA</div>
            <div class="image">IMAGE</div>
        </div>
    </section>

    <!-- DESKTOP -->
    <section class="device desktop-device">
        <h1>DESKTOP</h1>
        <div class="layout desktop">
            <div class="header">HEADER</div>
            <div class="menu">MENU</div>
            <div class="hero">HERO</div>
            <div class="main">MAIN</div>
            <div class="banner">BANNER</div>
            <div class="extra">EXTRA</div>
            <div class="image">IMAGE</div>
        </div>
    </section>

</div>

</body>
</html>
```
